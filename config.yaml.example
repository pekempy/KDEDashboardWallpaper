server:
  port: 4848
  host: 0.0.0.0
system:
  # Default working directory for Terminal/Update/folder-open commands.
  home_dir: /home/user
background:
  # Random wallpaper rotation pulls from an rclone remote. Leave rclone_remote
  # blank to disable background rotation entirely.
  rclone_remote: ''
  rclone_path: ''
display:
  # Number of monitors and their physical layout order (left-to-right)
  # e.g., if you have 3 screens, order [3, 1, 2] maps screen 1 to physical 3, etc.
  order: [1, 2, 3]
  # Which monitor in the 'order' list should show the full wallpaper
  wallpaper_monitor: 2
  # Assign widgets to specific monitors (1-based index from the order list)
  widgets:
    vitals: [1, 3]
    downloads: [2]
    container_health: [2]
    media_recent: [1]
    now_playing: [2]
    bookmarks: [1, 3]
    folders: [1, 3]
# Optional service widgets. Omit or leave a block out entirely to disable it -
# each one is only queried if present.
integrations:
  nzbget:
    url: http://localhost:6789/jsonrpc
    username: nzbget
    password: ''
  qui:
    url: http://localhost:4344
    api_key: ''
    instance_id: 1
  jellyfin:
    url: http://localhost:8096
    public_url: ''
    token: ''
  plex:
    url: http://localhost:32400
    public_url: ''
    token: ''
  immich:
    url: http://localhost:2283
    public_url: ''
    api_key: ''
# Optional - "Open Dockhand" shortcut button in the Container Health widget
# header (shown whenever an unhealthy/restarting container is detected).
# Leave the url blank to hide/disable that button.
dockhand:
  url: ''
ui:
  title: My Dashboard
  theme: dark
  accent_color: '#d4af37'
  refresh_interval_ms: 5000
quick_links:
  - name: Documents
    path: /home/user/Documents
    icon: 📂
  - name: Downloads
    path: /home/user/Downloads
    icon: 📥
bookmarks:
  - name: GitHub
    url: https://github.com
    icon: 🐙
